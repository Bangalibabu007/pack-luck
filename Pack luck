// ---------- luck math ----------

// Given the rarities pulled from one pack and the pack's baseline odds,
// score how "lucky" the pull was: sum of -log(probability) of each
// rarity obtained, normalized against the pack's own expected entropy.
function packLuckScore(packType, playersRarities) {
  const baseline = PACK_BASELINES[packType] || PACK_BASELINES.Custom;
  if (playersRarities.length === 0) return 50;

  let surprisal = 0;
  let maxSurprisal = 0;
  playersRarities.forEach((r) => {
    const p = Math.max(baseline[r] ?? 0.01, 0.002);
    surprisal += -Math.log2(p);
    // reference: surprisal of pulling the single rarest available slot
    const rarest = Math.min(
      ...Object.values(baseline).filter((v) => v > 0)
    );
    maxSurprisal += -Math.log2(Math.max(rarest, 0.002));
  });

  const ratio = maxSurprisal > 0 ? surprisal / maxSurprisal : 0.5;
  // squash to 0-100, centered so "expected" pulls land near 45-55
  const score = Math.min(100, Math.max(0, Math.round(ratio * 90 + 8)));
  return score;
}

function formatHour(time24) {
  if (!time24) return "";
  const [h, m] = time24.split(":").map(Number);
  const period = h >= 12 ? "PM" : "AM";
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return `${h12}:${String(m).padStart(2, "0")} ${period}`;
}

const TIME_BUCKETS = [
  { key: "night", label: "Late Night", range: "12–4 AM", test: (h) => h >= 0 && h < 4 },
  { key: "earlyMorning", label: "Early Morning", range: "4–8 AM", test: (h) => h >= 4 && h < 8 },
  { key: "morning", label: "Morning", range: "8 AM–12 PM", test: (h) => h >= 8 && h < 12 },
  { key: "afternoon", label: "Afternoon", range: "12–4 PM", test: (h) => h >= 12 && h < 16 },
  { key: "evening", label: "Evening", range: "4–8 PM", test: (h) => h >= 16 && h < 20 },
  { key: "lateEvening", label: "Late Evening", range: "8 PM–12 AM", test: (h) => h >= 20 && h < 24 },
];

function bucketForTime(time24) {
  if (!time24) return null;
  const h = Number(time24.split(":")[0]);
  return TIME_BUCKETS.find((b) => b.test(h)) || null;
}

const EPIC_PLUS = new Set(["Epic", "Legendary", "Icon"]);

function isEpicPlusPull(pack) {
  return pack.players.some((p) => EPIC_PLUS.has(p.rarity));
}

// Packs ordered oldest -> newest by date+time logged.
function chronological(packs) {
  return [...packs].sort((a, b) => {
    const ta = new Date(`${a.date}T${a.time || "00:00"}`).getTime();
    const tb = new Date(`${b.date}T${b.time || "00:00"}`).getTime();
    return ta - tb;
  });
}

// Pity/streak: how many packs since the last Epic+ pull, and the
// historical average gap between Epic+ pulls for context.
function computeStreak(packs) {
  const ordered = chronological(packs);
  if (ordered.length === 0) return { current: 0, avgGap: null, longestGap: 0 };

  let current = 0;
  for (let i = ordered.length - 1; i >= 0; i--) {
    if (isEpicPlusPull(ordered[i])) break;
    current++;
  }

  const gaps = [];
  let sinceLast = 0;
  ordered.forEach((p) => {
    if (isEpicPlusPull(p)) {
      gaps.push(sinceLast);
      sinceLast = 0;
    } else {
      sinceLast++;
    }
  });

  const avgGap = gaps.length ? Math.round((gaps.reduce((a, b) => a + b, 0) / gaps.length) * 10) / 10 : null;
  const longestGap = gaps.length ? Math.max(...gaps, current) : current;

  return { current, avgGap, longestGap };
}

// Dupe detection: how many times each player name has been pulled.
function computeDupes(packs) {
  const counts = new Map();
  packs.forEach((p) => {
    p.players.forEach((pl) => {
      const key = pl.name.trim().toLowerCase();
      if (!key) return;
      if (!counts.has(key)) counts.set(key, { name: pl.name, count: 0, best: pl });
      const entry = counts.get(key);
      entry.count += 1;
      if (pl.ovr > entry.best.ovr) entry.best = pl;
    });
  });
  return Array.from(counts.values()).sort((a, b) => b.count - a.count);
}

// Achievement badges derived purely from logged pack history.
function computeAchievements(packs) {
  const totalPacks = packs.length;
  const allPlayers = packs.flatMap((p) => p.players);
  const totalGems = packs.reduce((s, p) => s + p.cost, 0);
  const totalValue = packs.reduce((s, p) => s + p.totalValue, 0);
  const uniqueNames = new Set(allPlayers.map((p) => p.name.trim().toLowerCase())).size;
  const hasRarity = (r) => allPlayers.some((p) => p.rarity === r);
  const streak = computeStreak(packs);

  const badges = [
    { key: "first-pack", label: "First Pack", desc: "Log your first pack opening", earned: totalPacks >= 1, icon: "📦" },
    { key: "ten-packs", label: "Getting Serious", desc: "Log 10 pack openings", earned: totalPacks >= 10, icon: "🔟" },
    { key: "fifty-packs", label: "Veteran Opener", desc: "Log 50 pack openings", earned: totalPacks >= 50, icon: "🏆" },
    { key: "first-elite", label: "Elite Pull", desc: "Pull an Elite or better card", earned: hasRarity("Elite") || hasRarity("Epic") || hasRarity("Legendary") || hasRarity("Icon"), icon: "🟣" },
    { key: "first-epic", label: "Epic Hunter", desc: "Pull an Epic or better card", earned: hasRarity("Epic") || hasRarity("Legendary") || hasRarity("Icon"), icon: "🎯" },
    { key: "first-legendary", label: "Legendary Status", desc: "Pull a Legendary or Icon card", earned: hasRarity("Legendary") || hasRarity("Icon"), icon: "⭐" },
    { key: "first-icon", label: "Icon Collector", desc: "Pull an Icon card", earned: hasRarity("Icon"), icon: "👑" },
    { key: "big-spender", label: "Big Spender", desc: "Spend 5,000+ gems total", earned: totalGems >= 5000, icon: "💎" },
    { key: "collector", label: "Collector", desc: "Own 20 unique players", earned: uniqueNames >= 20, icon: "📚" },
    { key: "profit-master", label: "Profit Master", desc: "Positive profit after 10+ packs", earned: totalPacks >= 10 && totalValue - totalGems > 0, icon: "📈" },
    { key: "dry-spell", label: "Survived the Drought", desc: "Go 15+ packs without Epic+", earned: streak.longestGap >= 15, icon: "🏜️" },
  ];
  return badges;
}

function luckLabel(score) {
  if (score >= 85) return { label: "Blessed", emoji: "🔥", color: "#4FD1C5" };
  if (score >= 65) return { label: "Lucky", emoji: "🙂", color: "#4FD1C5" };
  if (score >= 40) return { label: "Average", emoji: "😐", color: "#D4A93E" };
  if (score >= 20) return { label: "Unlucky", emoji: "😕", color: "#C4544A" };
  return { label: "Rough Pull", emoji: "💀", color: "#C4544A" };
}

// Estimate a player's market value if not manually supplied.
function estimateValue(ovr, rarity) {
  const base = RARITY_VALUE_HINT[rarity] ?? 200;
  const ovrMult = Math.pow(1.09, Math.max(0, ovr - 75));
  return Math.round(base * ovrMult);
}

