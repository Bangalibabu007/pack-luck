function Players({ packs }) {
  const [query, setQuery] = useState("");
  const [rarityFilter, setRarityFilter] = useState("All");
  const [dupesOnly, setDupesOnly] = useState(false);

  const dupeCounts = useMemo(() => computeDupes(packs), [packs]);
  const dupeMap = useMemo(() => {
    const m = new Map();
    dupeCounts.forEach((d) => m.set(d.name.toLowerCase(), d.count));
    return m;
  }, [dupeCounts]);

  const allPlayers = useMemo(() => {
    const map = new Map();
    packs.forEach((p) => {
      p.players.forEach((pl) => {
        const key = pl.name.toLowerCase();
        if (!map.has(key) || map.get(key).ovr < pl.ovr) {
          map.set(key, pl);
        }
      });
    });
    return Array.from(map.values());
  }, [packs]);

  const totalDupes = dupeCounts.filter((d) => d.count > 1).length;

  const filtered = allPlayers
    .filter((p) => rarityFilter === "All" || p.rarity === rarityFilter)
    .filter((p) => !dupesOnly || (dupeMap.get(p.name.toLowerCase()) || 0) > 1)
    .filter((p) => p.name.toLowerCase().includes(query.toLowerCase()) || p.position.toLowerCase().includes(query.toLowerCase()))
    .sort((a, b) => b.ovr - a.ovr);

  const best = allPlayers.reduce((b, p) => (!b || p.ovr > b.ovr ? p : b), null);

  return (
    <div>
      <div style={styles.header}>
        <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 26, fontWeight: 700 }}>Collection</div>
      </div>
      <div style={{ color: "#8A8F98", fontSize: 13, marginBottom: 14 }}>
        {allPlayers.length} players collected{totalDupes > 0 ? ` · ${totalDupes} duplicate${totalDupes > 1 ? "s" : ""}` : ""}
      </div>

      {best && (
        <div style={{ ...styles.playerRow, border: "1px solid #D4A93E55", background: "#D4A93E0F", marginBottom: 16 }}>
          <div style={{ ...styles.ovrBadge, background: "#D4A93E" }}>{best.ovr}</div>
          <div style={{ flex: 1 }}>
            <div style={{ fontWeight: 700 }}>{best.name} ⭐</div>
            <div style={{ color: "#8A8F98", fontSize: 12 }}>{best.position} · {best.rarity} · Best OVR</div>
          </div>
        </div>
      )}

      <input
        style={styles.input}
        placeholder="Search by name or position..."
        value={query}
        onChange={(e) => setQuery(e.target.value)}
      />
      <div style={{ display: "flex", gap: 8, overflowX: "auto", margin: "12px 0" }}>
        {["All", ...RARITIES].map((r) => (
          <button
            key={r}
            onClick={() => setRarityFilter(r)}
            style={{ ...styles.chip, whiteSpace: "nowrap", ...(rarityFilter === r ? styles.chipActive : {}) }}
          >
            {r}
          </button>
        ))}
        <button
          onClick={() => setDupesOnly((d) => !d)}
          style={{ ...styles.chip, whiteSpace: "nowrap", ...(dupesOnly ? styles.chipActive : {}) }}
        >
          Dupes Only
        </button>
      </div>

      {filtered.map((p, i) => {
        const count = dupeMap.get(p.name.toLowerCase()) || 1;
        return (
          <div key={i} style={styles.playerRow}>
            <div style={{ ...styles.ovrBadge, background: RARITY_COLOR[p.rarity] }}>{p.ovr}</div>
            <div style={{ flex: 1 }}>
              <div style={{ fontWeight: 600 }}>{p.name}</div>
              <div style={{ color: "#8A8F98", fontSize: 12 }}>{p.position}</div>
            </div>
            {count > 1 && (
              <span style={{ ...styles.pill, color: "#D4A93E", borderColor: "#D4A93E55", background: "#D4A93E1A", marginRight: 4 }}>
                x{count}
              </span>
            )}
            <RarityPill rarity={p.rarity} />
          </div>
        );
      })}
    </div>
  );
}

function Stats({ packs, onNavigate }) {
  const [range, setRange] = useState("All Time");

  const filteredPacks = useMemo(() => {
    if (range === "All Time") return packs;
    const days = range === "7 Days" ? 7 : 30;
    const cutoff = Date.now() - days * 86400000;
    return packs.filter((p) => new Date(p.loggedAt).getTime() >= cutoff);
  }, [packs, range]);

  const gemsSpent = filteredPacks.reduce((s, p) => s + p.cost, 0);
  const playersFound = filteredPacks.reduce((s, p) => s + p.players.length, 0);
  const bestOvr = filteredPacks.reduce((m, p) => Math.max(m, ...p.players.map((pl) => pl.ovr)), 0);
  const avgOvr = playersFound
    ? Math.round(filteredPacks.reduce((s, p) => s + p.players.reduce((a, pl) => a + pl.ovr, 0), 0) / playersFound)
    : 0;
  const estValue = filteredPacks.reduce((s, p) => s + p.totalValue, 0);
  const profit = estValue - gemsSpent;

  // most successful pack type by avg OVR
  const byType = {};
  filteredPacks.forEach((p) => {
    if (!byType[p.packType]) byType[p.packType] = { count: 0, ovrSum: 0, players: 0 };
    byType[p.packType].count += 1;
    byType[p.packType].ovrSum += p.players.reduce((a, pl) => a + pl.ovr, 0);
    byType[p.packType].players += p.players.length;
  });
  const bestType = Object.entries(byType)
    .map(([type, d]) => ({ type, openings: d.count, avgOvr: d.players ? Math.round(d.ovrSum / d.players) : 0 }))
    .sort((a, b) => b.avgOvr - a.avgOvr)[0];

  // best time to open: day-of-week with highest average luck
  const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  const byDay = {};
  packs.forEach((p) => {
    const d = new Date(p.date).getDay();
    if (!byDay[d]) byDay[d] = { sum: 0, count: 0 };
    byDay[d].sum += p.luck;
    byDay[d].count += 1;
  });
  const dayStats = Object.entries(byDay)
    .map(([d, v]) => ({ day: dayNames[d], avgLuck: Math.round(v.sum / v.count), count: v.count }))
    .sort((a, b) => b.avgLuck - a.avgLuck);
  const bestDay = dayStats.find((d) => d.count >= 1);

  // best / worst time-of-day bucket by average luck
  const byBucket = {};
  packs.forEach((p) => {
    const bucket = bucketForTime(p.time);
    if (!bucket) return;
    if (!byBucket[bucket.key]) byBucket[bucket.key] = { sum: 0, count: 0, label: bucket.label, range: bucket.range };
    byBucket[bucket.key].sum += p.luck;
    byBucket[bucket.key].count += 1;
  });
  const bucketStats = Object.values(byBucket)
    .map((b) => ({ ...b, avgLuck: Math.round(b.sum / b.count) }))
    .sort((a, b) => b.avgLuck - a.avgLuck);
  const bestBucket = bucketStats[0];
  const worstBucket = bucketStats.length > 1 ? bucketStats[bucketStats.length - 1] : null;

  // chance of pulling Epic+ this session, based on logged pack types opened
  const epicPlusChance = useMemo(() => {
    if (filteredPacks.length === 0) return null;
    const typeCounts = {};
    filteredPacks.forEach((p) => (typeCounts[p.packType] = (typeCounts[p.packType] || 0) + 1));
    let weighted = 0;
    let total = 0;
    Object.entries(typeCounts).forEach(([type, count]) => {
      const b = PACK_BASELINES[type] || PACK_BASELINES.Custom;
      const chance = (b.Epic || 0) + (b.Legendary || 0) + (b.Icon || 0);
      weighted += chance * count;
      total += count;
    });
    return total ? weighted / total : 0;
  }, [filteredPacks]);

  return (
    <div>
      <div style={styles.header}>
        <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 26, fontWeight: 700 }}>Statistics</div>
      </div>

      <div style={{ display: "flex", flexDirection: "column", gap: 8, marginBottom: 18 }}>
        <button style={styles.navLinkCard} onClick={() => onNavigate("achievements")}>
          <span>🏆 Achievements</span>
          <span style={{ color: "#5A6070" }}>→</span>
        </button>
        <button style={styles.navLinkCard} onClick={() => onNavigate("compare")}>
          <span>⚖ Pack Comparison</span>
          <span style={{ color: "#5A6070" }}>→</span>
        </button>
        <button style={styles.navLinkCard} onClick={() => onNavigate("budget")}>
          <span>💎 Budget Settings</span>
          <span style={{ color: "#5A6070" }}>→</span>
        </button>
      </div>

      <div style={{ display: "flex", gap: 8, marginBottom: 18 }}>
        {["7 Days", "30 Days", "All Time"].map((r) => (
          <button
            key={r}
            onClick={() => setRange(r)}
            style={{ ...styles.chip, flex: 1, ...(range === r ? styles.chipActive : {}) }}
          >
            {r}
          </button>
        ))}
      </div>

      <div style={styles.grid2}>
        <StatCard label="PACKS OPENED" value={filteredPacks.length} />
        <StatCard label="GEMS SPENT" value={gemsSpent.toLocaleString()} />
      </div>
      <div style={styles.grid2}>
        <StatCard label="PLAYERS FOUND" value={playersFound} />
        <StatCard label="BEST OVR" value={bestOvr || "—"} />
      </div>
      <div style={styles.grid2}>
        <StatCard label="AVG OVR" value={avgOvr || "—"} />
        <StatCard label="EST. VALUE" value={estValue.toLocaleString()} />
      </div>

      <div style={{ ...styles.card2, marginTop: 4, background: profit >= 0 ? "#4FD1C50F" : "#C4544A14", border: `1px solid ${profit >= 0 ? "#4FD1C540" : "#C4544A40"}` }}>
        <div style={{ fontSize: 12, color: "#8A8F98", letterSpacing: 0.5 }}>TOTAL PROFIT / LOSS</div>
        <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 30, fontWeight: 700, color: profit >= 0 ? "#4FD1C5" : "#C4544A" }}>
          {profit >= 0 ? "+" : ""}{profit.toLocaleString()}
        </div>
        <div style={{ color: "#5A6070", fontSize: 12 }}>Estimated value obtained minus gems spent</div>
      </div>

      {epicPlusChance !== null && (
        <div style={{ ...styles.card2, marginTop: 12 }}>
          <div style={{ fontSize: 12, color: "#8A8F98", letterSpacing: 0.5, marginBottom: 6 }}>
            YOUR EPIC+ PULL RATE (based on packs opened)
          </div>
          <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 26, fontWeight: 700, color: "#D4A93E" }}>
            {(epicPlusChance * 100).toFixed(1)}%
          </div>
          <div style={{ color: "#5A6070", fontSize: 12 }}>chance per pack across the types you've logged</div>
        </div>
      )}

      {bestType && (
        <>
          <div style={{ fontSize: 12, color: "#8A8F98", letterSpacing: 0.5, margin: "22px 0 10px" }}>MOST SUCCESSFUL PACK TYPE</div>
          <div style={styles.card2}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <div>
                <div style={{ fontWeight: 700, fontSize: 16 }}>{bestType.type}</div>
                <div style={{ color: "#8A8F98", fontSize: 12 }}>{bestType.openings} opening{bestType.openings > 1 ? "s" : ""}</div>
              </div>
              <div style={{ textAlign: "right" }}>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 22, fontWeight: 700, color: "#D4A93E" }}>{bestType.avgOvr}</div>
                <div style={{ color: "#5A6070", fontSize: 11 }}>Avg OVR</div>
              </div>
            </div>
          </div>
        </>
      )}

      {bestDay && dayStats.length > 1 && (
        <>
          <div style={{ fontSize: 12, color: "#8A8F98", letterSpacing: 0.5, margin: "22px 0 10px" }}>BEST DAY TO OPEN (BY YOUR HISTORY)</div>
          <div style={styles.card2}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <div style={{ fontWeight: 700, fontSize: 18 }}>{bestDay.day}</div>
              <div style={{ color: luckLabel(bestDay.avgLuck).color, fontWeight: 700 }}>{bestDay.avgLuck} avg luck</div>
            </div>
            <div style={{ color: "#5A6070", fontSize: 11, marginTop: 4 }}>
              Based on {bestDay.count} pack{bestDay.count > 1 ? "s" : ""} opened this day — log more to sharpen this.
            </div>
          </div>
        </>
      )}

      {bestBucket && (
        <>
          <div style={{ fontSize: 12, color: "#8A8F98", letterSpacing: 0.5, margin: "22px 0 10px" }}>BEST & WORST TIME TO OPEN</div>
          <div style={styles.grid2}>
            <div style={{ ...styles.card2, flex: 1, border: "1px solid #4FD1C540", background: "#4FD1C50F" }}>
              <div style={{ fontSize: 11, color: "#4FD1C5", letterSpacing: 0.5, marginBottom: 4 }}>✓ BEST</div>
              <div style={{ fontWeight: 700, fontSize: 16 }}>{bestBucket.label}</div>
              <div style={{ color: "#8A8F98", fontSize: 12, marginBottom: 8 }}>{bestBucket.range}</div>
              <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 22, fontWeight: 700, color: "#4FD1C5" }}>
                {bestBucket.avgLuck}
              </div>
              <div style={{ color: "#5A6070", fontSize: 11 }}>avg luck · {bestBucket.count} pack{bestBucket.count > 1 ? "s" : ""}</div>
            </div>
            {worstBucket && (
              <div style={{ ...styles.card2, flex: 1, border: "1px solid #C4544A40", background: "#C4544A14" }}>
                <div style={{ fontSize: 11, color: "#C4544A", letterSpacing: 0.5, marginBottom: 4 }}>✕ WORST</div>
                <div style={{ fontWeight: 700, fontSize: 16 }}>{worstBucket.label}</div>
                <div style={{ color: "#8A8F98", fontSize: 12, marginBottom: 8 }}>{worstBucket.range}</div>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 22, fontWeight: 700, color: "#C4544A" }}>
                  {worstBucket.avgLuck}
                </div>
                <div style={{ color: "#5A6070", fontSize: 11 }}>avg luck · {worstBucket.count} pack{worstBucket.count > 1 ? "s" : ""}</div>
              </div>
            )}
          </div>
          <div style={{ color: "#5A6070", fontSize: 11, marginTop: 4 }}>
            Based on the time you logged with each pack — six 4-hour windows across the day. Log more packs across different times to sharpen this.
          </div>
        </>
      )}
    </div>
  );
}

