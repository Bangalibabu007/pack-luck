}

function Dial({ score }) {
  const { label, emoji, color } = luckLabel(score);
  const circumference = 2 * Math.PI * 54;
  const offset = circumference * (1 - score / 100);
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 20 }}>
      <svg width="128" height="128" viewBox="0 0 128 128">
        <circle cx="64" cy="64" r="54" fill="none" stroke="#1C2029" strokeWidth="10" />
        <circle
          cx="64"
          cy="64"
          r="54"
          fill="none"
          stroke={color}
          strokeWidth="10"
          strokeLinecap="round"
          strokeDasharray={circumference}
          strokeDashoffset={offset}
          transform="rotate(-90 64 64)"
          style={{ transition: "stroke-dashoffset 0.6s ease, stroke 0.4s ease" }}
        />
        <text x="64" y="58" textAnchor="middle" fontSize="26" fontWeight="800" fill="#EDE7DA" fontFamily="Oswald, sans-serif">
          {score}
        </text>
        <text x="64" y="78" textAnchor="middle" fontSize="10" fill="#8A8F98" fontFamily="Oswald, sans-serif" letterSpacing="1">
          / 100
        </text>
      </svg>
      <div>
        <div style={{ fontSize: 22 }}>{emoji}</div>
        <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 20, fontWeight: 700, color }}>
          {label}
        </div>
      </div>
    </div>
  );
}

function OddsBar({ packType }) {
  const baseline = PACK_BASELINES[packType] || PACK_BASELINES.Custom;
  const entries = RARITIES.map((r) => [r, baseline[r] ?? 0]).filter(([, v]) => v > 0);
  return (
    <div>
      <div style={{ display: "flex", height: 14, borderRadius: 7, overflow: "hidden", border: "1px solid #262B36" }}>
        {entries.map(([r, v]) => (
          <div
            key={r}
            title={`${r}: ${(v * 100).toFixed(1)}%`}
            style={{ width: `${v * 100}%`, background: RARITY_COLOR[r] }}
          />
        ))}
      </div>
      <div style={{ display: "flex", flexWrap: "wrap", gap: "6px 14px", marginTop: 10 }}>
        {entries.map(([r, v]) => (
          <div key={r} style={{ display: "flex", alignItems: "center", gap: 6, fontSize: 12, color: "#B9BFC9" }}>
            <span style={{ width: 8, height: 8, borderRadius: 2, background: RARITY_COLOR[r] }} />
            {r} <span style={{ color: "#5A6070" }}>{(v * 100).toFixed(1)}%</span>
          </div>
        ))}
      </div>
    </div>
  );
}

