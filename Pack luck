                    {["GK","CB","LB","RB","CDM","CM","CAM","LM","RM","LW","RW","ST","CF"].map((pos) => (
                      <option key={pos} value={pos}>{pos}</option>
                    ))}
                  </select>
                </div>
              </div>
              <div style={styles.grid2}>
                <div>
                  <div style={styles.miniLabel}>Rarity</div>
                  <select
                    style={styles.input}
                    value={p.rarity}
                    onChange={(e) => updatePlayer(p.id, "rarity", e.target.value)}
                  >
                    {RARITIES.map((r) => (
                      <option key={r} value={r}>{r}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <div style={styles.miniLabel}>Market value (optional)</div>
                  <input
                    style={styles.input}
                    type="number"
                    placeholder={`~${estimateValue(Number(p.ovr) || 75, p.rarity)}`}
                    value={p.value}
                    onChange={(e) => updatePlayer(p.id, "value", e.target.value)}
                  />
                </div>
              </div>
              {p.name && p.ovr && (
                <div style={{ display: "flex", alignItems: "center", gap: 10, marginTop: 10 }}>
                  <div style={{ ...styles.ovrBadge, background: RARITY_COLOR[p.rarity] }}>{p.ovr}</div>
                  <span style={{ fontWeight: 600 }}>{p.name}</span>
                  <RarityPill rarity={p.rarity} />
                </div>
              )}
            </div>
          ))}
          <button style={styles.dashedBtn} onClick={addPlayer}>+ Add Another Player</button>

          <div style={styles.footerRow}>
            <button style={styles.ghostBtn} onClick={() => setStep(1)}>← Back</button>
            <button
              style={{ ...styles.primaryBtn, opacity: canNext2 ? 1 : 0.4 }}
              disabled={!canNext2}
              onClick={() => setStep(3)}
            >
              Next →
            </button>
          </div>
        </div>
      )}

      {step === 3 && (
        <div style={styles.card}>
          <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 20, fontWeight: 700, marginBottom: 4 }}>
            {packName}
          </div>
          <div style={{ color: "#8A8F98", fontSize: 13, marginBottom: 16 }}>{packType} · {cost} gems · {date} {time && `at ${formatHour(time)}`}</div>

          <div style={{ marginBottom: 18 }}>
            {players.map((p) => (
              <div key={p.id} style={styles.playerRow}>
                <div style={{ ...styles.ovrBadge, background: RARITY_COLOR[p.rarity] }}>{p.ovr}</div>
                <div style={{ flex: 1 }}>
                  <div style={{ fontWeight: 600 }}>{p.name}</div>
                  <div style={{ color: "#8A8F98", fontSize: 12 }}>{p.position}</div>
                </div>
                <RarityPill rarity={p.rarity} />
              </div>
            ))}
          </div>

          <div style={styles.card2}>
            <div style={{ fontSize: 12, color: "#8A8F98", marginBottom: 12, letterSpacing: 0.5 }}>LUCK SCORE</div>
            <Dial score={luck} />
          </div>

          <div style={{ ...styles.card2, marginTop: 12 }}>
            <div style={{ fontSize: 12, color: "#8A8F98", letterSpacing: 0.5 }}>ESTIMATED PROFIT / LOSS</div>
            <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 30, fontWeight: 700, color: profit >= 0 ? "#4FD1C5" : "#C4544A", marginTop: 4 }}>
              {profit >= 0 ? "+" : ""}{profit.toLocaleString()} gems
