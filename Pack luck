          }}
        >
          <div style={{ fontSize: 28 }}>{b.icon}</div>
          <div style={{ flex: 1 }}>
            <div style={{ fontWeight: 700, fontSize: 15 }}>{b.label}</div>
            <div style={{ color: "#8A8F98", fontSize: 12 }}>{b.desc}</div>
          </div>
          {b.earned && <div style={{ color: "#D4A93E", fontSize: 18 }}>✓</div>}
        </div>
      ))}
    </div>
  );
}

function PackCompare({ packs, onBack }) {
  const [selected, setSelected] = useState(["Gold", "Elite"]);

  const toggle = (type) => {
    setSelected((s) => {
      if (s.includes(type)) return s.filter((t) => t !== type);
      if (s.length >= 3) return s;
      return [...s, type];
    });
  };

  const statsFor = (type) => {
    const relevant = packs.filter((p) => p.packType === type);
    const players = relevant.flatMap((p) => p.players);
    const avgOvr = players.length ? Math.round(players.reduce((a, p) => a + p.ovr, 0) / players.length) : null;
    const spent = relevant.reduce((s, p) => s + p.cost, 0);
    const value = relevant.reduce((s, p) => s + p.totalValue, 0);
    const b = PACK_BASELINES[type];
    const epicPlusOdds = (b.Epic || 0) + (b.Legendary || 0) + (b.Icon || 0);
    return { openings: relevant.length, avgOvr, spent, profit: value - spent, epicPlusOdds };
  };

  return (
    <div>
      <SubviewHeader title="Pack Comparison" onBack={onBack} />
      <div style={{ color: "#8A8F98", fontSize: 13, marginBottom: 12 }}>Pick up to 3 pack types to compare.</div>
      <div style={{ display: "flex", flexWrap: "wrap", gap: 8, marginBottom: 20 }}>
        {PACK_TYPES.map((t) => (
          <button
            key={t}
            onClick={() => toggle(t)}
            style={{ ...styles.chip, ...(selected.includes(t) ? styles.chipActive : {}) }}
          >
            {t}
          </button>
        ))}
      </div>

      {selected.map((type) => {
        const s = statsFor(type);
        return (
          <div key={type} style={{ ...styles.card, marginBottom: 14 }}>
            <div style={{ fontWeight: 700, fontSize: 17, marginBottom: 10 }}>{type}</div>
            <OddsBar packType={type} />
            <div style={{ display: "flex", gap: 20, marginTop: 14, flexWrap: "wrap" }}>
              <div>
                <div style={styles.miniLabel}>EPIC+ ODDS</div>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 18, fontWeight: 700, color: "#D4A93E" }}>
                  {(s.epicPlusOdds * 100).toFixed(1)}%
                </div>
              </div>
              <div>
                <div style={styles.miniLabel}>YOUR OPENINGS</div>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 18, fontWeight: 700 }}>{s.openings}</div>
              </div>
              <div>
                <div style={styles.miniLabel}>YOUR AVG OVR</div>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 18, fontWeight: 700 }}>{s.avgOvr ?? "—"}</div>
              </div>
              <div>
                <div style={styles.miniLabel}>YOUR PROFIT</div>
                <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 18, fontWeight: 700, color: s.openings ? (s.profit >= 0 ? "#4FD1C5" : "#C4544A") : "#5A6070" }}>
                  {s.openings ? `${s.profit >= 0 ? "+" : ""}${s.profit.toLocaleString()}` : "—"}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  );
}

function BudgetSettings({ budget, onSave, onBack }) {
  const [amount, setAmount] = useState(budget ? String(budget.amount) : "");
  const [period, setPeriod] = useState(budget ? budget.period : "weekly");

  const handleSave = () => {
    const n = Number(amount);
    if (n > 0) onSave({ amount: n, period });
    else onSave(null);
    onBack();
  };

  return (
    <div>
      <SubviewHeader title="Budget Settings" onBack={onBack} />
      <div style={styles.card}>
        <Field label="Gem budget">
          <input
            style={styles.input}
            type="number"
            placeholder="e.g. 2000"
            value={amount}
            onChange={(e) => setAmount(e.target.value)}
          />
        </Field>
        <Field label="Period">
          <div style={{ display: "flex", gap: 8 }}>
            {["weekly", "monthly"].map((p) => (
              <button
                key={p}
                onClick={() => setPeriod(p)}
                style={{ ...styles.chip, flex: 1, textTransform: "capitalize", ...(period === p ? styles.chipActive : {}) }}
              >
                {p}
              </button>
            ))}
          </div>
        </Field>
        <div style={{ color: "#5A6070", fontSize: 12, marginBottom: 16 }}>
          You'll see a progress bar and an alert on your Home screen when you're close to or over this limit. Leave the amount empty and save to remove your budget.
        </div>
        <button style={{ ...styles.primaryBtn, width: "100%" }} onClick={handleSave}>Save Budget</button>
      </div>
    </div>
  );
}

// ---------- app shell ----------

const TABS = [
  { key: "home", label: "Home", icon: "⌂" },
  { key: "add", label: "Add Pack", icon: "+" },
  { key: "history", label: "History", icon: "↻" },
  { key: "players", label: "Players", icon: "◈" },
  { key: "stats", label: "Stats", icon: "▤" },
];

export default function App() {
  const [tab, setTab] = useState("home");
  const [subview, setSubview] = useState(null);
  const [packs, setPacks] = useState([]);
  const [budget, setBudget] = useState(null);
  const [loaded, setLoaded] = useState(false);

  useEffect(() => {
    Promise.all([loadPacks(), loadBudget()]).then(([p, b]) => {
      setPacks(p);
      setBudget(b);
      setLoaded(true);
    });
  }, []);

  const persist = useCallback((next) => {
    setPacks(next);
    savePacks(next);
  }, []);

  const handleAddPack = (pack) => {
    persist([...packs, pack]);
    setTab("home");
  };

  const handleDelete = (id) => {
    persist(packs.filter((p) => p.id !== id));
  };

  const handleSaveBudget = (b) => {
    setBudget(b);
    saveBudget(b);
  };

  const goTab = (t) => {
    setSubview(null);
    setTab(t);
  };

  return (
    <div style={styles.app}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;700;800&family=Inter:wght@400;500;600&display=swap');
        * { box-sizing: border-box; font-family: 'Inter', sans-serif; }
        ::placeholder { color: #4A505C; }
        input:focus, select:focus, textarea:focus { outline: none; border-color: #D4A93E !important; }
        button { cursor: pointer; border: none; font-family: 'Inter', sans-serif; }
      `}</style>
      <div style={styles.screen}>
        {!loaded ? (
          <div style={{ padding: 40, textAlign: "center", color: "#5A6070" }}>Loading…</div>
        ) : (
          <div style={styles.content}>
            {subview === "achievements" && <Achievements packs={packs} onBack={() => setSubview(null)} />}
            {subview === "compare" && <PackCompare packs={packs} onBack={() => setSubview(null)} />}
            {subview === "budget" && (
              <BudgetSettings budget={budget} onSave={handleSaveBudget} onBack={() => setSubview(null)} />
            )}
            {!subview && tab === "home" && (
              <Home packs={packs} onAdd={() => goTab("add")} budget={budget} onOpenBudget={() => setSubview("budget")} />
            )}
            {!subview && tab === "add" && (
              <AddPackFlow onSave={handleAddPack} onCancel={() => goTab("home")} />
            )}
            {!subview && tab === "history" && <History packs={packs} onDelete={handleDelete} />}
            {!subview && tab === "players" && <Players packs={packs} />}
            {!subview && tab === "stats" && <Stats packs={packs} onNavigate={setSubview} />}
          </div>
        )}

        <div style={styles.nav}>
          {TABS.map((t) => (
            <button
              key={t.key}
              onClick={() => goTab(t.key)}
              style={{ ...styles.navBtn, color: !subview && tab === t.key ? "#D4A93E" : "#5A6070" }}
            >
              <div style={{ fontSize: 18 }}>{t.icon}</div>
              <div style={{ fontSize: 10, marginTop: 2, fontWeight: 600 }}>{t.label}</div>
            </button>
          ))}
        </div>
      </div>
    </div>
  );
}

