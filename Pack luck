function AddPackFlow({ onSave, onCancel }) {
  const [step, setStep] = useState(1);
  const [packName, setPackName] = useState("");
  const [packType, setPackType] = useState("Gold");
  const [cost, setCost] = useState("");
  const [date, setDate] = useState(new Date().toISOString().slice(0, 10));
  const [time, setTime] = useState(new Date().toTimeString().slice(0, 5));
  const [notes, setNotes] = useState("");
  const [players, setPlayers] = useState([
    { id: uid(), name: "", ovr: "", position: "ST", rarity: "Elite", value: "" },
  ]);

  const addPlayer = () =>
    setPlayers((p) => [...p, { id: uid(), name: "", ovr: "", position: "ST", rarity: "Elite", value: "" }]);

  const updatePlayer = (id, field, val) =>
    setPlayers((p) => p.map((pl) => (pl.id === id ? { ...pl, [field]: val } : pl)));

  const removePlayer = (id) => setPlayers((p) => p.filter((pl) => pl.id !== id));

  const canNext1 = packName.trim() && cost !== "" && Number(cost) > 0;
  const canNext2 = players.every((p) => p.name.trim() && p.ovr !== "");

  const totalValue = players.reduce((sum, p) => {
    const v = p.value !== "" ? Number(p.value) : estimateValue(Number(p.ovr) || 75, p.rarity);
    return sum + v;
  }, 0);

  const rarities = players.map((p) => p.rarity);
  const luck = packLuckScore(packType, rarities);
  const profit = totalValue - Number(cost || 0);

  const handleSave = () => {
    const pack = {
      id: uid(),
      packName: packName.trim(),
      packType,
      cost: Number(cost),
      date,
      time,
      notes,
      players: players.map((p) => ({
        ...p,
        ovr: Number(p.ovr),
        value: p.value !== "" ? Number(p.value) : estimateValue(Number(p.ovr) || 75, p.rarity),
      })),
      luck,
      totalValue,
      loggedAt: new Date().toISOString(),
    };
    onSave(pack);
  };

  return (
    <div>
      <div style={styles.header}>
        <div style={{ fontFamily: "Oswald, sans-serif", fontSize: 26, fontWeight: 700 }}>Log Pack</div>
        <div style={{ display: "flex", gap: 6 }}>
          {[1, 2, 3].map((s) => (
            <div
              key={s}
              style={{
                width: 28,
                height: 4,
                borderRadius: 2,
                background: s <= step ? "#D4A93E" : "#262B36",
              }}
            />
          ))}
        </div>
      </div>

      {step === 1 && (
        <div style={styles.card}>
          <Field label="Pack name">
            <input
              style={styles.input}
              placeholder="e.g. TOTY Pack, Gold Pack #4"
              value={packName}
              onChange={(e) => setPackName(e.target.value)}
            />
          </Field>
          <Field label="Pack type">
            <div style={styles.grid3}>
              {PACK_TYPES.map((t) => (
                <button
                  key={t}
                  onClick={() => setPackType(t)}
                  style={{
                    ...styles.chip,
                    ...(packType === t ? styles.chipActive : {}),
                  }}
                >
                  {t}
                </button>
              ))}
            </div>
          </Field>
          <Field label="Cost (gems)">
            <input
              style={styles.input}
              type="number"
              placeholder="e.g. 200"
              value={cost}
              onChange={(e) => setCost(e.target.value)}
            />
          </Field>
          <div style={styles.grid2}>
            <Field label="Date">
              <input style={styles.input} type="date" value={date} onChange={(e) => setDate(e.target.value)} />
            </Field>
            <Field label="Time">
              <input style={styles.input} type="time" value={time} onChange={(e) => setTime(e.target.value)} />
            </Field>
          </div>
          <Field label="Notes (optional)">
            <textarea
              style={{ ...styles.input, height: 70, resize: "none" }}
              placeholder="Any notes about this pack..."
              value={notes}
              onChange={(e) => setNotes(e.target.value)}
            />
          </Field>

          <div style={styles.oddsPreview}>
            <div style={{ fontSize: 12, color: "#8A8F98", marginBottom: 8, letterSpacing: 0.5 }}>
              KNOWN DROP ODDS FOR {packType.toUpperCase()}
            </div>
            <OddsBar packType={packType} />
          </div>

          <div style={styles.footerRow}>
            <button style={styles.ghostBtn} onClick={onCancel}>Cancel</button>
            <button
              style={{ ...styles.primaryBtn, opacity: canNext1 ? 1 : 0.4 }}
              disabled={!canNext1}
              onClick={() => setStep(2)}
            >
              Next →
            </button>
          </div>
        </div>
      )}

      {step === 2 && (
        <div style={styles.card}>
          <div style={{ color: "#8A8F98", marginBottom: 14, fontSize: 13 }}>
            Add the players you obtained from this pack.
          </div>
          {players.map((p, i) => (
            <div key={p.id} style={styles.playerCard}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
                <span style={{ color: "#8A8F98", fontSize: 13 }}>Player {i + 1}</span>
                {players.length > 1 && (
                  <button style={styles.linkBtn} onClick={() => removePlayer(p.id)}>Remove</button>
                )}
              </div>
              <input
                style={styles.input}
                placeholder="Player name"
                value={p.name}
                onChange={(e) => updatePlayer(p.id, "name", e.target.value)}
              />
              <div style={styles.grid2}>
                <div>
                  <div style={styles.miniLabel}>OVR</div>
                  <input
                    style={styles.input}
                    type="number"
                    placeholder="e.g. 88"
                    value={p.ovr}
                    onChange={(e) => updatePlayer(p.id, "ovr", e.target.value)}
                  />
                </div>
                <div>
                  <div style={styles.miniLabel}>Position</div>
                  <select
                    style={styles.input}
                    value={p.position}
                    onChange={(e) => updatePlayer(p.id, "position", e.target.value)}
